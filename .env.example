# Copy this file to .env.local (already gitignored, never committed)
# and fill in real values. Vite only exposes variables prefixed with
# VITE_ to the browser, that prefix is required, not optional.

# ── Local development (matches `supabase status` output after
#    `supabase start`, see README.md) ──
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-local-anon-key-here

# ── Production (once the real hosted Supabase project exists, see
#    workingTitle-BUILD-PROMPT.md's Build Phases) ──
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=paste-the-real-project-anon-key-here
